{
  "name": "inkback",
  "displayName": "Inkback",
  "version": "1.0.3",
  "description": "Comment and draw on your running localhost app, send it to Claude Code, and get a before/after slider for every change. Local only, no cloud. Based on open-source work by Angelo Dini (MIT).",
  "author": {
    "name": "Peter Trawka"
  },
  "homepage": "https://github.com/petertrawka/inkback",
  "repository": "https://github.com/petertrawka/inkback",
  "license": "MIT",
  "keywords": [
    "visual-feedback",
    "frontend",
    "design-review",
    "screenshot",
    "channel",
    "playwright"
  ],
  "mcpServers": {
    "inkback": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.mjs"
      ]
    }
  }
}
