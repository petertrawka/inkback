{
  "name": "inkback",
  "displayName": "Inkback",
  "version": "0.4.1",
  "description": "Comment and draw on your running localhost app, send it to Claude Code, and get a before/after slider for every change. Local only, no cloud. Built on claude-annotate by Angelo Dini (MIT).",
  "author": {
    "name": "Peter Trawka"
  },
  "homepage": "https://github.com/petertrawka/inkback",
  "repository": "https://github.com/petertrawka/inkback",
  "license": "MIT",
  "keywords": [
    "annotation",
    "frontend",
    "design-review",
    "screenshot",
    "channel",
    "playwright"
  ],
  "mcpServers": {
    "annotate": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.mjs"
      ]
    }
  }
}
